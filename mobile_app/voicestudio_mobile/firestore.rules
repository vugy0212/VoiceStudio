rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection configuration and user management collection for VoiceStudio Mobile Hub
    match /config/{docId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /invites/{inviteCode} {
      allow read, write: if true;
    }
  }
}

